# Write values without quotes: `docker run --env-file` keeps quotes as part of the value,
# while `docker compose` strips them, so a quoted password would differ between the two.

# Project API key: dashboard.embarkai.io → your project → Server Wallets → Create API Key
EMBARK_API_KEY=lp_your_api_key

# Any unique name for the agent's wallet within the project
EMBARK_WALLET_ID=my-research-agent

# Encrypts the client keyshare on the /data volume. Required.
EMBARK_KEYSHARE_PASSWORD=change-me-to-a-long-random-string

# Encrypts the keyshare backup in EmbarkAI ShareVault. Strongly recommended:
# it is the only way to recover the wallet if the volume is lost.
EMBARK_WALLET_BACKUP_PASSWORD=change-me-to-another-long-random-string

# Starting chain. 1279885899 = Lumia Pulsar testnet, 994873017 = Lumia Prism mainnet
EMBARK_CHAIN_ID=1279885899

# Verbose logs to stderr
EMBARK_DEBUG=false

# How long write tools wait for confirmation, ms (default 45000). Raise only together
# with your MCP client's tool timeout, see "Slow confirmations" in README.md
# EMBARK_RECEIPT_TIMEOUT_MS=45000

# Portfolio monitor (`docker run ... monitor`). All optional.
# Chains to watch, comma separated; defaults to EMBARK_CHAIN_ID
# MONITOR_CHAINS=1279885899,11155111
# ERC-20 tokens to watch as <chainId>:<address>, comma separated
# MONITOR_TOKENS=11155111:0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Seconds between polls (default 600) and the change that is worth reporting, in percent (default 1)
# MONITOR_INTERVAL_SEC=600
# MONITOR_THRESHOLD_PCT=1
